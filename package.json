{
  "name": "cuisine-pas-a-pas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "cuisine": "next build && next start -H 0.0.0.0",
