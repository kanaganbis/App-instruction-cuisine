# Copiez ce fichier en .env.local pour travailler avec votre dossier Google Drive.
# Sans ces deux valeurs, `npm run dev` lit le dossier local ./recettes.

# Lien de partage du dossier Drive (« Tous les utilisateurs disposant du lien »).
VITE_DRIVE_FOLDER=https://drive.google.com/drive/folders/VOTRE_DOSSIER

# Clé d'API Google avec la Google Drive API activée.
VITE_GOOGLE_API_KEY=VOTRE_CLE

# Développement uniquement : dossier local de recettes (par défaut ./recettes).
# RECETTES_DIR=./recettes
